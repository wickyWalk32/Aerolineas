@page "/admin/vuelos/editar/{Id:int}"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer

<PageTitle>Editar Vuelo - AeroReservas</PageTitle>

<div class="container-fluid px-4 py-3" style="max-width: 800px; font-family: 'Segoe UI', sans-serif;">
    <!-- Encabezado con Título y Botón Volver -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-normal mb-0" style="color: #111;">Editar Vuelo</h1>
        <button class="btn btn-light border border-secondary text-dark px-3 py-1 shadow-sm"
                style="background-color: #fff; font-size: 0.95rem;"
                @onclick="VolverAlMenu">
            Volver
        </button>
    </div>

    <!-- Mensaje de Error si ocurre alguno -->
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger shadow-sm mb-3" role="alert">
            @mensajeError
        </div>
    }

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando vuelo...</span>
            </div>
            <p class="text-secondary mt-2">Cargando datos del vuelo...</p>
        </div>
    }
    else
    {
        <!-- Tarjeta Principal del Formulario -->
        <div class="card shadow-sm border p-4" style="background-color: #f8f9fa; border-color: #777 !important; border-radius: 2px;">
            <EditForm Model="vueloDto" OnValidSubmit="GuardarCambios">
                <DataAnnotationsValidator />

                <div class="d-flex flex-column gap-3 mx-auto" style="max-width: 550px;">

                    <!-- Ciudad Origen -->
                    <div class="row align-items-center">
                        <label class="col-sm-4 col-form-label text-dark">Ciudad Origen</label>
                        <div class="col-sm-8">
                            <InputSelect @bind-Value="vueloDto.IdCiudadOrigen" class="form-select border-secondary-subtle">
                                <option value="0">-- Seleccione origen --</option>
                                @foreach (var ciudad in ciudades)
                                {
                                    <option value="@ciudad.Id">@ciudad.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <!-- Ciudad Destino -->
                    <div class="row align-items-center">
                        <label class="col-sm-4 col-form-label text-dark">Ciudad Destino</label>
                        <div class="col-sm-8">
                            <InputSelect @bind-Value="vueloDto.IdCiudadDestino" class="form-select border-secondary-subtle">
                                <option value="0">-- Seleccione destino --</option>
                                @foreach (var ciudad in ciudades)
                                {
                                    <option value="@ciudad.Id">@ciudad.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <!-- Fecha -->
                    <div class="row align-items-center">
                        <label class="col-sm-4 col-form-label text-dark">Fecha</label>
                        <div class="col-sm-8">
                            <InputDate @bind-Value="fechaVuelo" class="form-control border-secondary-subtle" />
                        </div>
                    </div>

                    <!-- Hora -->
                    <div class="row align-items-center">
                        <label class="col-sm-4 col-form-label text-dark">Hora</label>
                        <div class="col-sm-8">
                            <input type="time" @bind="horaVuelo" class="form-control border-secondary-subtle" />
                        </div>
                    </div>

                    <!-- Precio -->
                    <div class="row align-items-center">
                        <label class="col-sm-4 col-form-label text-dark">Precio</label>
                        <div class="col-sm-8">
                            <InputText @bind-Value="precioTexto" class="form-control border-secondary-subtle" placeholder="Ej: 15000.50" />
                        </div>
                    </div>

                    <!-- Aerolínea -->
                    <div class="row align-items-center">
                        <label class="col-sm-4 col-form-label text-dark">Aerolínea</label>
                        <div class="col-sm-8">
                            <InputText @bind-Value="vueloDto.Aerolinea" class="form-control border-secondary-subtle" />
                        </div>
                    </div>

                    <!-- Avión -->
                    <div class="row align-items-center">
                        <label class="col-sm-4 col-form-label text-dark">Avión</label>
                        <div class="col-sm-8">
                            <InputSelect @bind-Value="vueloDto.IdAvion" class="form-select border-secondary-subtle">
                                <option value="0">-- Seleccione avión --</option>
                                @foreach (var avion in aviones)
                                {
                                    <option value="@avion.Id">@avion.Descripcion</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <!-- Botón Guardar Centrado -->
                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-light border border-primary text-primary px-4 py-1 shadow-sm"
                                style="background-color: #fff; font-size: 0.95rem;" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar</span>
                            }
                        </button>
                    </div>

                </div>
            </EditForm>
        </div>
    }
</div>