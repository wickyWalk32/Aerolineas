@page "/login"
@layout EmptyLayout
@rendermode InteractiveServer

<PageTitle>Iniciar Sesión - AeroReservas.com</PageTitle>

<div class="login-container d-flex flex-column align-items-center justify-content-center min-vh-100 py-4" style="background-color: #f4f6f8;">

    <!-- Tarjeta Principal de Login -->
    <div class="login-card shadow-sm border p-4 bg-white" style="max-width: 420px; width: 100%; border-radius: 6px;">
        <!-- Título principal de la aplicación -->
        <h1 class="brand-title h4 fw-bold text-center mb-1">AeroReservas.com</h1>
        <p class="subtitle text-muted text-center mb-4" style="font-size: 0.9rem;">Ingresa tus credenciales para acceder</p>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger py-2" role="alert" style="font-size: 0.9rem;">
                @mensajeError
            </div>
        }

        <EditForm FormName="LoginForm" Model="loginModel" OnValidSubmit="ProcesarLogin">
            <DataAnnotationsValidator />

            <div class="form-group mb-3">
                <label for="email" class="form-label" style="font-size: 0.9rem;">Correo Electrónico</label>
                <InputText @ref="inputEmail" @bind-Value="loginModel.Email" class="form-control" disabled="@cargando" id="email" placeholder="ejemplo@correo.com" />
            </div>

            <div class="form-group mb-3">
                <label for="contrasenia" class="form-label" style="font-size: 0.9rem;">Contraseña</label>
                <InputText @bind-Value="loginModel.Contrasenia" class="form-control" disabled="@cargando" id="contrasenia" type="password" placeholder="••••••••" />
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-2 py-2" disabled="@cargando">
                @if (cargando)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Ingresando...</span>
                }
                else
                {
                    <span>Iniciar Sesión</span>
                }
            </button>

            <!-- Botón / Enlace para Registrarse -->
            <button type="button" class="btn btn-outline-secondary w-100 py-2" @onclick="IrARegistro" disabled="@cargando">
                Registrarse
            </button>
        </EditForm>
    </div>

    <br>
    
    <!-- Tarjeta de Credenciales de Prueba -->
    <div class="card shadow-sm border-0 mb-4 p-3 bg-light text-secondary" style="max-width: 420px; width: 100%; font-size: 0.85rem; border-left: 4px solid #0d6efd !important;">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="fw-bold text-dark"><i class="bi bi-info-circle me-1"></i> Datos de prueba:</span>
        </div>
        <div class="row g-2">
            <div class="col-6 border-end">
                <span class="fw-semibold text-dark d-block mb-1">Admin:</span>
                <div><strong>Email:</strong> admin@email.com</div>
                <div><strong>Pass:</strong> admin</div>
            </div>
            <div class="col-6 ps-3">
                <span class="fw-semibold text-dark d-block mb-1">Usuario:</span>
                <div><strong>Email:</strong> usu@email.com</div>
                <div><strong>Pass:</strong> usu</div>
            </div>
        </div>
    </div>

</div>
