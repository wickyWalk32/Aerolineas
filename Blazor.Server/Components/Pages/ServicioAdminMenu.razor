@page "/admin/servicios"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer

<PageTitle>Administrar Servicios - AeroReservas</PageTitle>

<div class="container-fluid px-4 py-3" style="max-width: 1250px; font-family: 'Segoe UI', sans-serif;">
    <!-- Encabezado con Título y Botones -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-normal mb-0" style="color: #111;">Administrar Servicios</h1>
        <div class="d-flex gap-2">
            <button class="btn btn-light border border-primary text-primary px-3 py-1 shadow-sm"
                    style="background-color: #fff; font-size: 0.95rem;"
                    @onclick="IrANuevoServicio">
                Nuevo Servicio
            </button>

            <button class="btn btn-light border border-secondary text-secondary px-3 py-1 shadow-sm"
                    style="background-color: #fff; font-size: 0.95rem;"
                    @onclick="VolverAlMenuAdmin">
                Volver al Menú Principal
            </button>
        </div>
    </div>

    <!-- Mensaje de Error si ocurre alguno -->
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger shadow-sm mb-3" role="alert">
            @mensajeError
        </div>
    }

    <!-- Estado de Carga -->
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando servicios...</span>
            </div>
            <p class="text-secondary mt-2">Cargando listado de servicios...</p>
        </div>
    }
    else if (servicios == null || !servicios.Any())
    {
        <div class="alert alert-info text-center shadow-sm" role="alert">
            No hay servicios registrados en el sistema.
        </div>
    }
    else
    {
        <!-- Contenedor con Scroll y Virtualización -->
        <div style="max-height: 75vh; overflow-y: auto;" class="pe-1">
            <Virtualize Items="servicios" Context="servicio">
                <div class="card mb-2 shadow-sm border" style="background-color: #f2f2f2; border-color: #666 !important; border-radius: 1px;">
                    <div class="card-body p-3 style-winforms">

                        <!-- Fila Superior -->
                        <div class="d-flex align-items-center text-nowrap mb-2" style="font-size: 0.95rem; color: #000;">
                            <!-- ID -->
                            <div class="text-center" style="width: 50px;">
                                @servicio.Id
                            </div>

                            <!-- Nombre -->
                            <div style="width: 250px;" class="ps-2 fw-semibold">
                                @servicio.Nombre
                            </div>

                            <!-- Precio -->
                            <div style="width: 140px;" class="text-start ms-auto">
                                $ @servicio.Precio.ToString("0.00")
                            </div>

                            <!-- Botones -->
                            <div class="d-flex gap-2 ms-2">
                                <button class="btn btn-sm btn-light border text-dark shadow-sm"
                                        style="background-color: #fff; border-color: #bbb; font-size: 0.88rem; width: 72px; padding: 2px 0;"
                                        @onclick="() => EditarServicio(servicio.Id)">
                                    Editar
                                </button>

                                <button class="btn btn-sm btn-light border text-dark shadow-sm"
                                        style="background-color: #fff; border-color: #bbb; font-size: 0.88rem; width: 72px; padding: 2px 0;"
                                        @onclick="() => SolicitarEliminacion(servicio)">
                                    Eliminar
                                </button>
                            </div>
                        </div>

                        <!-- Fila Inferior (Descripción) -->
                        <div class="d-flex align-items-center text-nowrap" style="font-size: 0.95rem; color: #555;">
                            <!-- Espaciador ID -->
                            <div style="width: 50px;"></div>

                            <!-- Descripción -->
                            <div class="ps-2 text-truncate" style="max-width: 800px;">
                                <span class="fw-bold">Descripción:</span> @servicio.Descripcion
                            </div>
                        </div>

                    </div>
                </div>
            </Virtualize>
        </div>
    }
</div>

<!-- Modal de confirmación para eliminar -->
@if (servicioAEliminar != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fs-6 fw-bold text-dark">Confirmar eliminación - AeroReservas.com</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminacion"></button>
                </div>
                <div class="modal-body text-dark" style="font-size: 0.95rem;">
                    ¿Está seguro de que desea eliminar el servicio <strong>@servicioAEliminar.Nombre</strong>?
                </div>
                <div class="modal-footer bg-light p-2">
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CancelarEliminacion">Cancelar</button>
                    <button type="button" class="btn btn-danger btn-sm px-3" @onclick="ConfirmarEliminacion">Aceptar</button>
                </div>
            </div>
        </div>
    </div>
}