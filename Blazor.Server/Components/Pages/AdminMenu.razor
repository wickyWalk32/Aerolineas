@page "/admin/menu"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer

<PageTitle>Panel de Administración - AeroReservas.com</PageTitle>

<div class="container mt-4">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Panel de Control General (Admin)</h3>
            <button class="btn btn-outline-light btn-sm" @onclick="CerrarSesion">Cerrar Sesión</button>
        </div>
        <div class="card-body">
            <AuthorizeView>
                <Authorized>
                    <h4>¡Bienvenido Administrador, @context.User.Identity?.Name!</h4>
                    <p class="text-muted">Gestión integral de usuarios, flota y destinos.</p>
                </Authorized>
            </AuthorizeView>

            <div class="row mt-4">
                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-secondary">
                        <div class="card-body text-center">
                            <h5 class="card-title">Gestión de Usuarios</h5>
                            <p class="card-text">Alta, baja y modificación de datos de usuarios registrados.</p>
                            <button class="btn btn-danger" @onclick="IrAGestionUsuarios">Ir a Usuarios</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-secondary">
                        <div class="card-body text-center">
                            <h5 class="card-title">Gestión de Aviones</h5>
                            <p class="card-text">Administración de la flota de aeronaves disponibles.</p>
                            <button class="btn btn-outline-danger" disabled>Próximamente</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-secondary">
                        <div class="card-body text-center">
                            <h5 class="card-title">Gestión de Vuelos</h5>
                            <p class="card-text">Programación de rutas, destinos, fechas y precios.</p>
                            <button class="btn btn-outline-danger" disabled>Próximamente</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>