@page "/admin/reservas"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer

<PageTitle>Consultar Reservas - AeroReservas</PageTitle>

<div class="container-fluid px-0" style="font-family: 'Segoe UI', sans-serif;">
    <!-- Header Superior -->
    <header class="bg-white border-bottom shadow-sm px-4 py-3 mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 fw-normal mb-0" style="color: #111;">Consultar Reservas</h1>
                <small class="text-secondary">Listado general de todas las reservas registradas en el sistema</small>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-light border text-dark px-3 py-1 shadow-sm"
                        style="background-color: #fff; border-color: #ccc; font-size: 0.9rem;"
                        @onclick="VolverAlMenuAdmin">
                    Volver al menú
                </button>
                <button class="btn btn-light border text-dark px-3 py-1 shadow-sm"
                        style="background-color: #fff; border-color: #ccc; font-size: 0.9rem;"
                        @onclick="CerrarSesion">
                    Salir del sistema
                </button>
            </div>
        </div>
    </header>

    <main class="container px-4 pb-5">
        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando reservas...</span>
                </div>
                <p class="text-secondary mt-2">Cargando reservas del sistema...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="alert alert-danger shadow-sm">@mensajeError</div>
        }
        else
        {
            <div class="row">
                <!-- Columna Izquierda: Listado de Reservas (9 columnas) -->
                <div class="col-lg-9">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted small">
                            Mostrando <strong>@reservasPaginadas.Count</strong> de <strong>@reservasFiltradas.Count</strong> reservas
                            @if (reservasFiltradas.Count != todasLasReservasItems.Count)
                            {
                                <span>(filtradas de <strong>@todasLasReservasItems.Count</strong> totales)</span>
                            }
                        </span>
                    </div>

                    @if (reservasPaginadas.Count == 0)
                    {
                        <div class="alert alert-info shadow-sm text-center py-4">
                            No se encontraron reservas con los filtros aplicados.
                        </div>
                    }
                    else
                    {
                        <!-- Listado de Reservas -->
                        <div class="d-flex flex-column gap-2 mb-4">
                            @foreach (var item in reservasPaginadas)
                            {
                                var esPendiente = string.Equals(item.EstadoCalculado, "Pendiente", StringComparison.OrdinalIgnoreCase);

                                <div class="card shadow-sm border bg-light p-2 px-3" style="border-radius: 4px; border-color: #666 !important;">
                                    <div class="d-flex align-items-center justify-content-between text-nowrap" style="font-size: 0.9rem; color: #000;">

                                        <!-- Reserva # -->
                                        <div style="width: 75px;">
                                            <span class="text-muted d-block" style="font-size: 0.75rem;">Reserva</span>
                                            <strong>#@item.ReservaId</strong>
                                        </div>

                                        <!-- Usuario -->
                                        <div style="width: 170px;" class="overflow-hidden">
                                            <span class="text-muted d-block" style="font-size: 0.75rem;">Usuario</span>
                                            <span class="text-truncate d-block" title="@item.UsuarioBusqueda">@item.UsuarioInfo</span>
                                        </div>

                                        <!-- Vuelo (Origen - Destino) -->
                                        <div style="width: 210px;" class="overflow-hidden">
                                            <span class="text-muted d-block" style="font-size: 0.75rem;">Vuelo (Origen - Destino)</span>
                                            <strong class="text-truncate d-block" title="@item.Origen - @item.Destino (@item.Aerolinea)">
                                                @item.Origen - @item.Destino
                                            </strong>
                                        </div>

                                        <!-- Fecha del vuelo -->
                                        <div style="width: 145px;">
                                            <span class="text-muted d-block" style="font-size: 0.75rem;">Fecha del Vuelo</span>
                                            <span>@(item.FechaVuelo.HasValue? item.FechaVuelo.Value.ToString("dd/MM/yyyy HH:mm") : "Sin fecha")</span>
                                        </div>

                                        <!-- Pasajes -->
                                        <div style="width: 65px;" class="text-center">
                                            <span class="text-muted d-block" style="font-size: 0.75rem;">Pasajes</span>
                                            <span>@item.CantidadPasajes</span>
                                        </div>

                                        <!-- Estado calculado -->
                                        <div style="width: 100px;">
                                            <span class="text-muted d-block" style="font-size: 0.75rem;">Estado</span>
                                            <span class="badge @(esPendiente ? "bg-warning text-dark" : "bg-secondary")">
                                                @item.EstadoCalculado
                                            </span>
                                        </div>

                                        <!-- Botón Ver -->
                                        <div class="ms-2">
                                            <button class="btn btn-sm btn-outline-primary px-3 shadow-sm"
                                                    style="font-size: 0.85rem;"
                                                    @onclick="() => VerReserva(item.ReservaId)">
                                                Ver
                                            </button>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Controles de Paginación (20 reservas por página) -->
                        <div class="d-flex justify-content-center align-items-center gap-3 my-4">
                            <button class="btn btn-outline-secondary btn-sm px-3"
                                    disabled="@(paginaActual == 0)"
                                    @onclick="PaginaAnterior">
                                &lt; Anterior
                            </button>

                            <span class="text-secondary" style="font-size: 0.95rem;">
                                Página <strong>@(paginaActual + 1)</strong> de <strong>@(totalPaginas == 0 ? 1 : totalPaginas)</strong>
                            </span>

                            <button class="btn btn-outline-secondary btn-sm px-3"
                                    disabled="@(paginaActual >= totalPaginas - 1)"
                                    @onclick="PaginaSiguiente">
                                Siguiente &gt;
                            </button>
                        </div>
                    }
                </div>

                <!-- Columna Derecha: Panel de Filtros (3 columnas) -->
                <div class="col-lg-3">
                    <div class="card shadow-sm border p-3 bg-white" style="border-radius: 6px;">
                        <h5 class="text-center fw-bold border-bottom pb-2 mb-3" style="font-size: 1.1rem; color: #333;">Filtros</h5>

                        <!-- Filtro por Usuario -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Usuario</label>
                            <input type="text"
                                   class="form-control form-control-sm"
                                   placeholder="Nombre, apellido o email..."
                                   @bind="filtroUsuario"
                                   @bind:event="oninput"
                                   @bind:after="AplicarFiltros" />
                        </div>

                        <!-- Filtro por Vuelo -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Vuelo</label>
                            <input type="text"
                                   class="form-control form-control-sm"
                                   placeholder="Origen, destino o aerolínea..."
                                   @bind="filtroVuelo"
                                   @bind:event="oninput"
                                   @bind:after="AplicarFiltros" />
                        </div>

                        <!-- Filtro por Estado -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Estado</label>
                            <select class="form-select form-select-sm"
                                    @bind="filtroEstado"
                                    @bind:after="AplicarFiltros">
                                <option value="Todos">Todos</option>
                                <option value="Pendiente">Pendiente</option>
                                <option value="Finalizada">Finalizada</option>
                            </select>
                        </div>

                        <!-- Botón Limpiar Filtros -->
                        <div class="d-grid mt-2">
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    @onclick="LimpiarFiltros">
                                Limpiar filtros
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </main>
</div>