@page "/admin/vuelos"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer

<PageTitle>Administrar Vuelos - AeroReservas</PageTitle>

<div class="container-fluid px-4 py-3" style="max-width: 1250px; font-family: 'Segoe UI', sans-serif;">
    <!-- Encabezado con Título y Botones -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-normal mb-0" style="color: #111;">Administrar Vuelos</h1>
        <div class="d-flex gap-2">
            <button class="btn btn-light border border-primary text-primary px-3 py-1 shadow-sm"
                    style="background-color: #fff; font-size: 0.95rem;"
                    @onclick="IrANuevoVuelo">
                Nuevo Vuelo
            </button>

            <button class="btn btn-light border border-secondary text-secondary px-3 py-1 shadow-sm"
                    style="background-color: #fff; font-size: 0.95rem;"
                    @onclick="VolverAlMenuAdmin">
                Volver al Menú Principal
            </button>
        </div>
    </div>

    <!-- Mensaje de Error si ocurre alguno -->
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger shadow-sm mb-3" role="alert">
            @mensajeError
        </div>
    }

    <!-- Estado de Carga -->
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando vuelos...</span>
            </div>
            <p class="text-secondary mt-2">Cargando listado de vuelos...</p>
        </div>
    }
    else if (vuelos == null || !vuelos.Any())
    {
        <div class="alert alert-info text-center shadow-sm" role="alert">
            No hay vuelos registrados en el sistema.
        </div>
    }
    else
    {
        <!-- Contenedor con Scroll y Virtualización -->
        <div style="max-height: 75vh; overflow-y: auto;" class="pe-1">
            <Virtualize Items="vuelos" Context="vuelo">
                <div class="card mb-2 shadow-sm border" style="background-color: #f2f2f2; border-color: #666 !important; border-radius: 1px;">
                    <div class="card-body p-3 style-winforms">

                        <!-- Fila Superior -->
                        <div class="d-flex align-items-center text-nowrap mb-2" style="font-size: 0.95rem; color: #000;">
                            <!-- ID -->
                            <div class="text-center" style="width: 50px;">
                                @vuelo.Id
                            </div>

                            <!-- Origen -->
                            <div style="width: 250px;" class="ps-2">
                                Origen: @vuelo.CiudadOrigenNombre
                            </div>

                            <!-- Destino -->
                            <div style="width: 210px;">
                                Destino: @vuelo.CiudadDestinoNombre
                            </div>

                            <!-- Fecha y Hora -->
                            <div style="width: 230px;" class="d-flex justify-content-start gap-4">
                                <span>@vuelo.FechaHoraVuelo.ToString("dd/MM/yyyy")</span>
                                <span>@vuelo.FechaHoraVuelo.ToString("HH:mm")</span>
                            </div>

                            <!-- Precio -->
                            <div style="width: 140px;" class="text-start ms-auto">
                                $ @vuelo.Precio.ToString("0.00")
                            </div>

                            <!-- Botones -->
                            <div class="d-flex gap-2 ms-2">
                                <button class="btn btn-sm btn-light border text-dark shadow-sm"
                                        style="background-color: #fff; border-color: #bbb; font-size: 0.88rem; width: 72px; padding: 2px 0;"
                                        @onclick="() => EditarVuelo(vuelo.Id)">
                                    Editar
                                </button>

                                <!-- En la iteración donde está el botón de eliminar -->
                                <button class="btn btn-sm btn-light border text-dark shadow-sm"
                                        style="background-color: #fff; border-color: #bbb; font-size: 0.88rem; width: 72px; padding: 2px 0;"
                                        @onclick="() => EliminarVuelo(vuelo)">
                                    Eliminar
                                </button>
                            </div>
                        </div>

                        <!-- Fila Inferior -->
                        <div class="d-flex align-items-center text-nowrap" style="font-size: 0.95rem; color: #000;">
                            <!-- Espaciador ID -->
                            <div style="width: 50px;"></div>

                            <!-- Avión -->
                            <div style="width: 250px;" class="ps-2">
                                Avión: @vuelo.AvionDescripcion
                            </div>

                            <!-- Capacidad -->
                            <div style="width: 210px;">
                                Capacidad: @vuelo.AvionCapacidad
                            </div>

                            <!-- Aerolínea -->
                            <div style="width: 370px;">
                                Aerolínea: @vuelo.Aerolinea
                            </div>
                        </div>

                    </div>
                </div>
            </Virtualize>
        </div>
    }
</div>