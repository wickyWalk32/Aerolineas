@page "/admin/aviones/nuevo"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer

<PageTitle>Nuevo Avión - AeroReservas</PageTitle>

<div class="container-fluid px-4 py-3" style="max-width: 800px; font-family: 'Segoe UI', sans-serif;">
    <!-- Encabezado con Título y Botón Volver -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-normal mb-0" style="color: #111;">Nuevo Avión</h1>
        <button class="btn btn-light border border-secondary text-dark px-3 py-1 shadow-sm"
                style="background-color: #fff; font-size: 0.95rem;"
                @onclick="VolverAlMenu">
            Volver
        </button>
    </div>

    <!-- Mensaje de Error -->
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger shadow-sm mb-3" role="alert">
            @mensajeError
        </div>
    }

    <!-- Tarjeta Principal del Formulario -->
    <div class="card shadow-sm border p-4" style="background-color: #f8f9fa; border-color: #777 !important; border-radius: 2px;">
        <EditForm Model="avionDto" OnValidSubmit="GuardarAvion">
            <DataAnnotationsValidator />

            <div class="d-flex flex-column gap-3 mx-auto" style="max-width: 550px;">

                <!-- Descripción -->
                <div class="row align-items-center">
                    <label class="col-sm-4 col-form-label text-dark">Descripción</label>
                    <div class="col-sm-8">
                        <InputText @bind-Value="avionDto.Descripcion" class="form-control border-secondary-subtle" placeholder="Ej: Boeing 737-800" />
                    </div>
                </div>

                <!-- Capacidad -->
                <div class="row align-items-center">
                    <label class="col-sm-4 col-form-label text-dark">Capacidad</label>
                    <div class="col-sm-8">
                        <InputNumber @bind-Value="avionDto.Capacidad" class="form-control border-secondary-subtle" placeholder="Ej: 180" />
                    </div>
                </div>

                <!-- Estado de Disponibilidad -->
                <div class="row align-items-center">
                    <label class="col-sm-4 col-form-label text-dark">Estado</label>
                    <div class="col-sm-8">
                        <InputSelect @bind-Value="avionDto.EstadoDisponibilidad" class="form-select border-secondary-subtle">
                            <option value="">-- Seleccione Estado --</option>
                            <option value="Disponible">Disponible</option>
                            <option value="En Mantenimiento">En Mantenimiento</option>
                            <option value="Fuera de Servicio">Fuera de Servicio</option>
                        </InputSelect>
                    </div>
                </div>

                <!-- Botón Guardar Centrado -->
                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-light border border-primary text-primary px-4 py-1 shadow-sm"
                            style="background-color: #fff; font-size: 0.95rem;" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar</span>
                        }
                    </button>
                </div>

            </div>
        </EditForm>
    </div>
</div>